[Unit]
Description=MySQL HA Validation Alert Receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/ha/ha-alert-receiver -listen=127.0.0.1:9099
Restart=on-failure
RestartSec=2
User=ha-controller
Group=ha-controller
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
