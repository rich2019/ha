[Unit]
Description=MySQL HA Node Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/ha/agent.env
ExecStart=/opt/ha/mysql-agent
Restart=on-failure
RestartSec=3
User=ha-agent
Group=ha-agent
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
