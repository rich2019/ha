HA_HTTP_ADDR=:8080
HA_CLUSTER_NAME=mysql-ha-dev
HA_CONTROLLER_ID=controller-1
HA_ETCD_ENDPOINTS=http://etcd-1:2379,http://etcd-2:2379,http://etcd-3:2379
HA_AGENTS_FILE=/etc/ha/agents.json
HA_AGENT_CA_FILE=/etc/ha/pki/ca.crt
HA_AGENT_CERT_FILE=/etc/ha/pki/controller-1.crt
HA_AGENT_KEY_FILE=/etc/ha/pki/controller-1.key
HA_AUTO_FAILOVER_EXECUTE=false
HA_REQUIRE_ETCD=true
